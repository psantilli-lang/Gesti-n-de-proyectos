rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check connectivity validation
    match /test/{testId} {
      allow read, write: if true;
    }

    // SAP Projects collection - allow read and write
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // App Users directory - allow read and write
    match /users/{userId} {
      allow read, write: if true;
    }

    // Notification logs - allow read and write
    match /notificationLogs/{logId} {
      allow read, write: if true;
    }
  }
}

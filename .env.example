# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =====================================================================
# Central SMTP Email Configuration (Nodemailer)
# Despacho centralizado de notificaciones sin depender de cuentas personales.
# =====================================================================
# Para Gmail/Google Workspace:
#   SMTP_HOST: smtp.gmail.com
#   SMTP_PORT: 465 (con secure=true) o 587 (con secure=false)
#   SMTP_USER: Correo de la cuenta central que enviará los avisos
#   SMTP_PASS: Contraseña de aplicación de 16 letras generada en Google
#   SMTP_FROM: "Nombre Mostrado <correo@dominio.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sistema SAP Crucianelli <notificaciones@crucianelli.com>"

